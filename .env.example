# Copy to .env to override. Claude is reached through the same Bedrock gateway
# settings Claude Code uses (ANTHROPIC_BEDROCK_BASE_URL, AWS_REGION and
# CLAUDE_CODE_SKIP_BEDROCK_AUTH from your shell).
CHAT_MODEL=eu.anthropic.claude-sonnet-5-5
DEEP_MODEL=eu.anthropic.claude-opus-5-5
PORT=3001
DB_PATH=data/coding-practice.db
# Voice transcription with whisper.cpp. These are the defaults.
WHISPER_BIN=whisper-cli
WHISPER_MODEL=data/models/ggml-large-v3-turbo-q5_0.bin
